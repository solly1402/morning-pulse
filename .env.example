# ==============================================================================
# AI API KEY (Chọn 1 trong 2 để tóm tắt bằng AI - Khuyên dùng Gemini vì miễn phí)
# ==============================================================================
# Lấy key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Hoặc dùng OpenAI / Groq / OpenRouter (Tùy chọn)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# KÊNH NHẬN BẢN TIN (Cấu hình kênh bạn muốn bật)
# ==============================================================================
# 1. Telegram Bot (Tạo bot qua @BotFather, lấy Chat ID qua @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. Discord Webhook (Server Settings -> Integrations -> Webhooks -> Copy URL)
DISCORD_WEBHOOK_URL=
